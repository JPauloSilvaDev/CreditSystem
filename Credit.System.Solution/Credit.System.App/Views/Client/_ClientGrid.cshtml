@model ClientViewModel;

@using Newtonsoft.Json

<div class="card shadow mb-4">
	<div class="card-header py-3 d-flex justify-content-between align-items-center">
		<h6 class="m-0 font-weight-bold text-primary">
			<i class="fas fa-table me-2"></i>My Clients
		</h6>
		<div class="d-flex">
			<label for="customLenght">Entries per page</label>
			<select class="form-control" style="width: 20%" id="customLength">
				<option value="10">10</option>
				<option value="25">25</option>
				<option value="100">100</option>
			</select>
			<div class="input-group me-2">
				<span class="input-group-text bg-light border-0">
					<i class="fas fa-search"></i>
				</span>
				<input type="text" class="form-control border-0 bg-light" id="searchInput" placeholder="Pesquisar...">
			</div>

			<button class="btn btn-light" id="refreshTable">
				<i class="fas fa-sync-alt"></i>
			</button>


		</div>

	</div>

</div>


<div class="card-body">

	<div class="table-responsive">
		<table id="dataTableClient" class="table">
			<thead class="table-light">
				<tr>
					<th class="text-nowrap">Primary Name</th>
					<th class="text-nowrap">Secondary Name</th>
					<th class="text-nowrap">Phone</th>
					<th>Email</th>
					<th>Actions</th>
				</tr>
			</thead>
			<tbody>

				@if(Model.Clients != null)
				{

					@foreach (Client client in Model.Clients)
					{
						<tr>
							<td class="align-middle text-nowrap">@client.PrimaryName</td>
							<td class="align-middle text-nowrap">@client.SecondaryName</td>
							<td class="align-middle text-nowrap">@client.PrimaryPhone</td>
							<td class="align-middle text-nowrap">@client.Email</td>

							<td class="text-end">
								<div class="btn-group btn-group-sm">

									<button class="btn btn-primary btn-sm" data-bs-placement="top" title="View Details" onclick="getAdditionalDetails(@JsonConvert.SerializeObject(client))">
										<i class="fas fa-eye"></i>
									</button>

									<button class="btn btn-success btn-sm" data-bs-placement="top" title="Edit" data-bs-toggle="collapse" data-bs-target="#collapseEditClient" aria-expanded="false" aria-controls="collapseEditClient" onclick="SetEditClient(@JsonConvert.SerializeObject(client))">
										<i class="fas fa-edit"></i>
									</button>

									<button class="btn btn-danger btn-sm" style="cursor:pointer" data-bs-toggle="tooltip" data-bs-placement="top" title="Delete" onclick="GetRemoveClientModal(@client.ClientId)">
										<i class="fas fa-trash"></i>
									</button>

								</div>
							</td>
						</tr>
					}
				}
				else
				{
					<tr>
						<td class="align-middle text-nowrap">No entries found</td>
					</tr>
				}

			</tbody>
		</table>
	</div>
</div>